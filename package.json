{
  "name": "@zodal/store-localstorage",
  "version": "0.3.0",
  "description": "zodal DataProvider adapter for browser localStorage",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./iife": "./dist/zodal-store-localstorage.iife.js",
    "./lite": {
      "types": "./dist/lite.d.ts",
      "import": "./dist/lite.js",
      "require": "./dist/lite.cjs"
    }
  },
  "sideEffects": false,
  "unpkg": "./dist/zodal-store-localstorage.iife.js",
  "jsdelivr": "./dist/zodal-store-localstorage.iife.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@zodal/core": "^0.2.0",
    "@zodal/store": "^0.2.0"
  },
  "devDependencies": {
    "@zodal/core": "^0.2.0",
    "@zodal/store": "^0.2.0",
    "jsdom": "^26.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "fake-indexeddb": "^6.2.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/i2mint/zodal-store-localstorage.git"
  },
  "keywords": [
    "zodal",
    "dataprovider",
    "localstorage",
    "storage",
    "adapter"
  ],
  "packageManager": "pnpm@9.15.0"
}
